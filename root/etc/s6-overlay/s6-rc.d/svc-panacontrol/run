#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Runs the app as abc. exec: s6 sends SIGTERM straight to the Python process,
# so its lifespan handler runs and sends stopstream to the camera.

cd /app || exit 1

if [[ -z ${LSIO_NON_ROOT_USER} ]]; then
    # s6-setuidgid keeps root's HOME (/root), which abc can't read.
    export HOME=/config
    exec s6-setuidgid abc python3 -m lumixremote.app
else
    exec python3 -m lumixremote.app
fi
