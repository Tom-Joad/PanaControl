# Copy to .env and adjust. .env is gitignored.
# Only for the container; the native start reads config.toml.

# The camera's address on the local network
LUMIX_CAMERA_IP=192.0.2.10

# Name as it appears on the camera's display during registration
LUMIX_DEVICE_NAME=lumix-remote

# Local UDP port for the frames. Must be the same on host and container.
LUMIX_STREAM_PORT=49199

# Address the web interface is published on. 127.0.0.1 keeps it local,
# 0.0.0.0 opens it to the network; the app has no login.
LUMIX_WEB_BIND=127.0.0.1

LUMIX_LOG_LEVEL=INFO

# Host names for the interface besides IP addresses, single words (tower)
# and *.local, e.g. behind a reverse proxy; comma-separated
LUMIX_ALLOWED_HOSTS=

# User and group the app runs as (not 0)
PUID=1000
PGID=1000
UMASK=022

# Time zone for the time stamps in the log
TZ=Etc/UTC
